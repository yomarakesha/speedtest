# Copy to deploy/.env and edit to point the "wazuh-agent" service (profile
# "wazuh") at your actual Wazuh manager. docker compose loads .env
# automatically from the same directory as docker-compose.yml.
#
# This repo does not ship a Wazuh manager (see Global Constraints in
# docs/superpowers/plans/2026-09-05-microservices-audit-wazuh.md) — point
# these at an existing Wazuh deployment, or at the official single-node
# stack (github.com/wazuh/wazuh-docker) joined to the "netsec" network.
WAZUH_MANAGER_SERVER=wazuh.manager
WAZUH_MANAGER_PORT=1514
WAZUH_REGISTRATION_SERVER=wazuh.manager
WAZUH_REGISTRATION_PORT=1515
WAZUH_AGENT_GROUP=default
# Only needed if your manager's authd requires a shared enrollment password.
WAZUH_REGISTRATION_PASSWORD=
